# Copy to .env for local use. Never commit real values.
# demo = seeded synthetic routing (works with no key). live = Ola Maps.
ROUTING_MODE=demo
# Only needed when ROUTING_MODE=live. Server side only, never exposed to the browser.
OLA_MAPS_API_KEY=
# SQLite by default. For Postgres use e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/smart_assign.db
# Extra browser origins allowed by CORS (comma separated). Not needed when one service serves both.
FRONTEND_ORIGIN=http://localhost:5173
# Optional shared passcode. When set, every /api call needs the X-Access-Token header.
APP_ACCESS_TOKEN=
